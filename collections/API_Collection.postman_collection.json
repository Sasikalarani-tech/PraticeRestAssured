	"item": [
		{
			"name": "Create new User_negative",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status should be 409 as User already exists\",function()\r",
							"{\r",
							"    pm.response.to.have.status(409);\r",
							"    let json_response=pm.response.json();\r",
							"    pm.expect(json_response.message).to.eql(\"An account already exists with the same email address\");\r",
							"     pm.expect(json_response.success).to.eql(false);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"name\":\"princy\",\r\n    \"email\":\"princy_p@gmail.com\",\r\n    \"password\":\"princy@123\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_Url}}/users/register",
					"host": [
						"{{base_Url}}"
					],
					"path": [
						"users",
						"register"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get healthcheck",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Response should contain status as 200\",function()\r",
							"{\r",
							"pm.response.to.have.status(200);\r",
							"let json=pm.response.json();\r",
							"pm.expect(json.success).to.eql(true);\r",
							"pm.expect(json.message).to.eql(\"Notes API is Running\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_Url}}/health-check",
					"host": [
						"{{base_Url}}"
					],
					"path": [
						"health-check"
					]
				}
			},
			"response": []
		},
		{
			"name": "Existing User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let json=pm.response.json();\r",
							"pm.environment.set(\"token\",json.data.token);\r",
							"pm.test(\"Status code should be 200\",function()\r",
							"{\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"pm.test(\"Status code should be 200\",function()\r",
							"{\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"pm.test(\"Token should be present in the response\",function()\r",
							"{\r",
							"let response=pm.response.json();\r",
							"pm.expect(response.data.token).is.not.null;\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"email\":\"princy_p@gmail.com\",\r\n    \"password\":\"princy@123\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_Url}}/users/login",
					"host": [
						"{{base_Url}}"
					],
					"path": [
						"users",
						"login"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Users",
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"auth": {
					"type": "apikey",
					"apikey": [
						{
							"key": "value",
							"value": "{{token}}",
							"type": "string"
						},
						{
							"key": "key",
							"value": "x-auth-token",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"name\":\"princy\",\r\n    \"email\":\"princy_p@gmail.com\",\r\n    \"password\":\"princy@123\"\r\n}"
				},
				"url": {
					"raw": "{{base_Url}}/users/profile",
